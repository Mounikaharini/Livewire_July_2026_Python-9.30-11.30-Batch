#single inheritance

class whatsapp:
    def features(self):
        print("-----------  Features Of Whatsapp  -----------")
        feature = ["Chats","Voice Call","Video Call","Status","Group Chat"]
        for i in feature:
            print(i)
        print()
    def textChatFeatures(self):
        print("-----------  Text Chat Features Of Whatsapp  -----------")
        textChatFeature = ["Message","Delete the Message","Edit Message","Disappearing Message"]
        for i in textChatFeature:
            print(i)
        print()
    

class whatsappClone(whatsapp):
    def cloneFeature(self):
        print("Deleted Message Not Deleted here")


w = whatsapp()
w.features()
w.textChatFeatures()

wc = whatsappClone()
wc.features()
wc.textChatFeatures()
wc.cloneFeature()

class calc1:
    def add(self,a,b):
        print(a+b)
    def sub(self,a,b):
        print(a-b)
        
class calc2(calc1):
    def mul(self,a,b):
        print(a*b)
    def div(self,a,b):
        print(a/b)


c1 = calc1()
c1.add(20,20)
c1.sub(5,50)

c2 = calc2()
c2.add(20,20)
c2.sub(5,50)
c2.mul(8,5)
c2.div(52,5)








